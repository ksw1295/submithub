# SubmitHub 환경 변수 설정 템플릿
# 이 파일을 .env 로 복사한 뒤 실제 운영 환경에 맞게 값을 설정하세요. (.env 는 git 에 커밋하지 않습니다)

# 1. 서비스 도메인 (Caddy 가 이 도메인으로 HTTPS 인증서를 자동 발급받습니다)
DOMAIN=submithub.example.com

# 2. 데이터베이스 접속 계정 및 비밀번호
DB_USER=submithub
DB_PASSWORD=your-secure-db-password-here
DB_ROOT_PASSWORD=your-secure-root-password-here

# 3. 교수 가입 인증 코드 (운영 환경에서는 빈 값이 아닌 보안 코드를 지정해야 서버가 정상 시작됩니다)
PROFESSOR_SIGNUP_CODE=your-secret-professor-signup-code

# 4. Google Gemini API 키 (AI 피드백 검토/판정 기능 사용 시 필요)
GEMINI_API_KEY=your-gemini-api-key-here

# 5. 시연용 샘플 데이터 자동 로딩 (운영 환경 기본값: false)
DEMO_DATA=false

# 6. 요청 횟수 제한 (분당 최대 요청 횟수)
RATE_LIMIT_LOGIN=10
RATE_LIMIT_SUBMIT=5
RATE_LIMIT_AI_JUDGE=3

# 7. Gemini AI 일일 호출 한도
AI_DAILY_LIMIT=100

# 8. 시연 데이터 주기적 자동 리셋 cron (예: 매일 자정 "0 0 0 * * *", 비활성화 시 빈 문자열)
DEMO_RESET_CRON=
