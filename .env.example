# docker compose 용 설정 예시. 이 파일을 .env 로 복사해서 값을 바꿔 쓴다. (.env 는 커밋하지 않는다)
DB_USER=submithub
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# true: DB 가 비어 있으면 시연용 샘플 데이터(교수 1, 학생 7, 과제 2 ...)를 넣는다
DEMO_DATA=true

# 비워 두면 누구나 교수로 가입할 수 있다. 값을 넣으면 교수 가입 시 이 코드를 입력해야 한다
PROFESSOR_SIGNUP_CODE=
